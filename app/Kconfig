menu "Embedded Departure Board"
source "Kconfig.zephyr"

#### LED DISPLAY TEST SETTINGS ####
config LED_DISPLAY_TEST
  bool "Select to run LED display test instead of main application"

#### STOP SETTINGS ####
config STOP_ID
  string "Bus stop ID"

config STOP_MAX_ROUTES
  int "Maximum number of routes expected at the configured stop"
  default 5

config ROUTE_MAX_DEPARTURES
  int "Maximum number of departures expected for EACH route"
  default 2

#### SIGN SETTINGS ####

config UPDATE_STOP_FREQUENCY_SECONDS
  int "The frequency at which stop departure times are updated in seconds"
  default 30
  help
    Boot-time default only: runtime-overridable from the pigeon shadow's
    "update_stop_interval" key (net/pigeon_client.c), clamped there to
    5-45s -- the ceiling keeps main's watchdog-feeding loop inside
    MAX_TIME_INACTIVE_BEFORE_RESET_MS.

config NUMBER_OF_DISPLAY_BOXES
  int "The number of display boxes connected to the sign"
  default 6

config MAX_TIME_INACTIVE_BEFORE_RESET_MS
  int "Maximum amount of time the system can remain inactive before it resets in milliseconds"
  default 60000

#### LIGHT_SENSOR SETTINGS ####

config LIGHT_SENSOR
  bool "Enable I2C ambient light sensor"
  default y

#### HTTP stop request settings ####

config HTTP_REQUEST_RETRY_COUNT
  int "Defines the number of HTTP request retries on failure (i.e. 404)"
  default 0
  help
    Boot-time default only: runtime-overridable from the pigeon shadow's
    "http_retry_count" key (src/runtime_config.h), clamped to 0-3.

config STOP_JSON_BUF_SIZE
  int "Defines the max size for stop JSON response body receive buffer"
  default 4096

## SWIFTLY ##
config SWIFTLY_API_HOSTNAME
  string "Swiftly API hostname used to retrieve stop predictions data"
  default "api.goswift.ly"

config SWIFTLY_API_PATH
  string "Swiftly API HTTP path used to retrieve stop predictions data"
  default "/real-time/pioneer-valley-pvta/predictions"

config SWIFTLY_API_NUMBER_OF_PREDICTIONS
  string "The number of future predictions to return per route/stop in the response"
  default "1"

#### NTP SETTINGS ####

config PRIMARY_NTP_SERVER
  string "Primary NTP server used to synchronize system time"
  default "time.nist.gov"
  help
    Boot-time default only: runtime-overridable from the pigeon shadow's
    "ntp_server_primary" key (src/runtime_config.h).

config FALLBACK_NTP_SERVER
  string "Fallback NTP server used to synchronize system time if the primary server is unavailable"
  default "us.pool.ntp.org"
  help
    Boot-time default only: runtime-overridable from the pigeon shadow's
    "ntp_server_fallback" key (src/runtime_config.h).

config NTP_REQUEST_TIMEOUT_MS
  int "Max amount of time allowed waiting for a single NTP query response for in milliseconds"
  # The NIST time servers should never be queried more frequently than once every 4 seconds.
  default 4000
  help
    Boot-time default only: runtime-overridable from the pigeon shadow's
    "ntp_timeout_ms" key (src/runtime_config.h), clamped to 500-30000.

config NTP_FETCH_RETRY_COUNT
  int "Max attempts to fetch time from NTP server before changing to fallback server"
  default 2
  help
    Boot-time default only: runtime-overridable from the pigeon shadow's
    "ntp_retry_count" key (src/runtime_config.h), clamped to 1-5.

#### PIGEON (PidgeIoT device management) SETTINGS ####
# CONFIG_PIGEON/_ENDPOINT/_TOKEN/etc. are the `pigeon` module's own Kconfig
# (west-managed, see app/west.yml) -- this app-level namespace is only for
# knobs specific to how THIS app drives the library (see net/pigeon_client.c).

config PIGEON_CLIENT_POLL_INTERVAL_SECONDS
  int "Default shadow/telemetry poll interval in seconds"
  default 300
  help
    Fallback used until the shadow's target_config supplies its own
    "telemetry_interval" (see net/pigeon_client.c) -- same convention as
    pigeon-examples' https_init sample. Kept coarse by default: this is a
    mains-powered sign, but the LTE data budget for the poll's shadow GET
    plus telemetry POSTs still isn't free.

config PIGEON_CLIENT_THREAD_STACK_SIZE
  int "Pigeon client thread stack size (bytes)"
  default 5632
  help
    Stack for the dedicated thread all PidgeIoT I/O runs on (see
    net/pigeon_client.c) -- sized for the pigeon library's HTTPS client
    plus JSON shadow decode, NOT for a TLS handshake: pigeon's sockets
    are plain offloaded IPPROTO_TLS_1_2, so the handshake runs inside
    the modem, never on this stack. Evidence (2026-08-08 RAM diet):
    thread-analyzer peak 3112 on a full shadow+telemetry cycle; the
    FOTA path (dfu_target/flash_img frames on top) ran two complete
    real downloads within the earlier 6144 -- 5632 keeps >=1KB over a
    conservative FOTA estimate. Bump back first if a FOTA soak ever
    shows an MPU stack fault on this thread.

endmenu
