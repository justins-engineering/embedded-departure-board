# Zephyr build folders (build/ = as-flashed; build_debug/ / build_release/ =
# the 2026-07-29 refresh builds, see README's bench-day handoff)
build/
build_*/

# Zephyr logs
log*.txt

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Secret keys
app/keys/private/*

# Python venv
.venv/

# Cache
.cache/

# West deps
mbedtls/
nrf/
nrfxlib/
pcf85063a/
tools/
modules/
bootloader/
zephyr/
multiplexer/
pigeon/

# Real device secrets (CONFIG_PIGEON_ENDPOINT/CONFIG_PIGEON_TOKEN, etc.)
app/prj.local.conf

# Cortex debugging states
.vscode/.cortex-debug.registers.state.json

# Shipped-artifact archive (see README: Archiving shipped artifacts)
releases/

# Host test build output
tests/parse_swiftly/.build/

# The west-dependency ignores above are unanchored, so `zephyr/` matches a
# directory of that name at ANY depth -- including the stub headers the host
# parser tests need. Those stubs are first-party source, not a fetched
# dependency, and without them a fresh clone cannot build the tests at all.
!tests/parse_swiftly/zephyr/
