# Zephyr build folders (build/ = as-flashed; build_debug/ / build_release/ =
# the 2026-07-29 refresh builds, see README's bench-day handoff)
build/
build_*/

# Zephyr logs
log*.txt

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Secret keys
app/keys/private/*

# Python venv
.venv/

# Cache
.cache/

# West deps -- top-level directories `west update` creates. Anchored with a
# leading slash because these are ordinary names: unanchored, `zephyr/` also
# matches a directory of that name at any depth, and it silently swallowed
# the first-party stub headers under tests/parse_swiftly/zephyr/.
#
# mbedtls, pcf85063a and tools are leftovers from an older manifest that
# fetched them at the root; the current one puts mbedtls under modules/ and
# fetches neither of the others. Kept anchored rather than deleted so a
# manifest that brings them back is still covered.
/mbedtls/
/nrf/
/nrfxlib/
/pcf85063a/
/tools/
/modules/
/bootloader/
/zephyr/
/multiplexer/
/pigeon/

# Real device secrets (CONFIG_PIGEON_ENDPOINT/CONFIG_PIGEON_TOKEN, etc.)
app/prj.local.conf

# Cortex debugging states
.vscode/.cortex-debug.registers.state.json

# Shipped-artifact archive (see README: Archiving shipped artifacts)
releases/

# Host test build output
tests/parse_swiftly/.build/
