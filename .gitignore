# Zephyr build folders (build/ = as-flashed; build_debug/ / build_release/ =
# the 2026-07-29 refresh builds, see README's bench-day handoff)
build/
build_*/

# Zephyr logs
log*.txt

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Secret keys
app/keys/private/*

# Python venv
.venv/

# Cache
.cache/

# West deps -- exactly the top-level directories `west update` creates, no
# more. Anchored with a leading slash because these are ordinary names:
# unanchored, `zephyr/` also matches a directory of that name at any depth,
# and it silently swallowed the first-party stub headers under
# tests/parse_swiftly/zephyr/.
#
# Add an entry only for a directory west actually fetches at the root
# (`west list`). One that matches nothing costs nothing today, but the day
# it does match it hides a first-party directory without saying so, whereas
# an unignored dep shows up as untracked noise you can see and fix.
/nrf/
/nrfxlib/
/modules/
/bootloader/
/zephyr/
/multiplexer/
/pigeon/

# Real device secrets (CONFIG_PIGEON_ENDPOINT/CONFIG_PIGEON_TOKEN, etc.)
app/prj.local.conf

# Cortex debugging states
.vscode/.cortex-debug.registers.state.json

# Shipped-artifact archive (see README: Archiving shipped artifacts)
releases/

# Host test build output
tests/parse_swiftly/.build/
tests/stop_id/.build/
